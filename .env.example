# ===== Application =====
APP_NAME=CampusBuddy
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key

# ===== Database =====
DATABASE_URL=sqlite+aiosqlite:///./campus_buddy.db

# ===== JWT =====
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== LLM (Pydantic-AI) =====
PDAI_BASE_URL=https://api.openai.com/v1
PDAI_API_KEY=sk-your-api-key-here
PDAI_MODEL=gpt-4o-mini

# ===== Server =====
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ===== CORS =====
CORS_ORIGINS=["*"]
